---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';
import AdSlot from '../components/AdSlot.astro';
import { RESEARCH_REVIEW_DATE, SOURCES } from '../lib/editorial.js';

const title = 'Food Delivery Tip Calculator: Percentage or Custom Dollar Tip';
const description =
  'Calculate a food delivery tip by percentage or custom dollar amount, add delivery fees, tax and other fees, and split the total accurately.';

const nav = [
  { href: '#calculator', label: 'Calculator' },
  { href: '#delivery-guide', label: 'Guide' },
  { href: '#faq', label: 'FAQ' },
  { href: '#sources', label: 'Sources' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://restauranttipcalculator.com/food-delivery-tip-calculator/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Restaurant Tip Calculator',
          item: 'https://restauranttipcalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Food Delivery Tip Calculator',
          item: 'https://restauranttipcalculator.com/food-delivery-tip-calculator/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/food-delivery-tip-calculator/#app',
      url: 'https://restauranttipcalculator.com/food-delivery-tip-calculator/',
      name: 'Food Delivery Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Percentage presets, custom percentage, and custom dollar tip',
        'Delivery fee, tax, and other fee inputs',
        'Delivery and other fees excluded from the percentage tip basis',
        'Optional choice to include entered tax in the percentage tip basis',
        'Exact cent-reconciled bill splitting for up to 99 people',
        'Optional whole-dollar round-up with the extra amount shown',
        'No sign-up; calculations run in the browser',
      ],
    },
  ],
});
---

<Layout title={title} description={description} path="/food-delivery-tip-calculator/" jsonLd={jsonLd} nav={nav}>
  <section class="hero">
    <p class="guide-intro"><a href="/">Restaurant tip calculator</a> / Food delivery</p>
    <h1>Food Delivery Tip Calculator</h1>
    <p class="lede">
      Enter the food subtotal and any delivery fee, choose a percentage or custom dollar tip, and see the total based
      on the amounts you enter. Tax and other fees can be added under More options.
    </p>
    <p class="guide-intro">
      <strong>Quick answer:</strong> For an etiquette reference,
      <a href={SOURCES.emilyPost}>Emily Post currently recommends 10–15% of the bill for delivery</a>. This is
      etiquette guidance, not a measured national average or universal rule; choose any percentage or custom dollar
      amount that fits your situation.
    </p>
  </section>

  <Calculator mode="delivery" />

  <AdSlot format="leaderboard" position="below" id="ad-below" />

  <section class="section" id="how-it-works">
    <h2>How the delivery calculator handles your bill</h2>
    <ol class="steps">
      <li>
        <span class="step-n" aria-hidden="true">1.</span><p>
          <strong>Enter the food subtotal.</strong> This is the default basis for a percentage tip.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">2.</span><p>
          <strong>Add the delivery fee, tax, or other fees you actually owe.</strong> They are included in the payable
          total. Delivery and other fees stay outside the percentage tip basis.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">3.</span><p>
          <strong>Choose the tip you want.</strong> Use a preset, enter a custom percentage, or enter an exact dollar
          amount. If you want the entered tax included in a percentage tip basis, turn that option on.
        </p>
      </li>
    </ol>
  </section>

  <section class="section" id="delivery-guide">
    <h2>How much should you tip for food delivery?</h2>
    <div class="guide-grid">
      <div>
        <p class="guide-intro">
          Delivery-tip percentages are <strong>etiquette recommendations</strong>, not universal platform rules.
          Emily Post currently recommends 10–15% of the bill for delivery and gives a $2–5 pizza-delivery guideline
          depending on the size and difficulty of the delivery.
        </p>
        <div class="menu">
          <div class="menu-row">
            <span class="menu-name">Emily Post delivery guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">10–15%</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Pizza-delivery dollar guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">$2–5, depending on size/difficulty</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Calculator choices</span><span class="dots" aria-hidden="true"></span><span class="menu-val">preset, custom %, or custom $</span>
          </div>
        </div>
        <p class="menu-src">
          Source: Emily Post — General Tipping Guide. The calculator also lets you
          choose any other amount that fits your situation.
        </p>
      </div>
      <div>
        <table class="worked">
          <caption>A $32 food subtotal with a $2.99 delivery fee, before tax</caption>
          <thead>
            <tr><th scope="col">Tip rate</th><th scope="col">Tip amount</th><th scope="col">Entered total</th></tr>
          </thead>
          <tbody>
            <tr><td>15%</td><td>$4.80</td><td>$39.79</td></tr>
            <tr><td>18%</td><td>$5.76</td><td>$40.75</td></tr>
            <tr><td>20%</td><td>$6.40</td><td>$41.39</td></tr>
            <tr><td>22%</td><td>$7.04</td><td>$42.03</td></tr>
          </tbody>
        </table>
        <p class="worked-note">
          The table demonstrates calculator math; it does not claim that every rate shown is an etiquette
          recommendation. Add tax and other fees if they apply to your order.
        </p>
      </div>
    </div>

    <div class="prose">
      <h3>Is a delivery fee the same as a tip?</h3>
      <p>
        Do not assume so. A delivery fee, service fee, small-order fee, or priority fee is a separate charge from a
        voluntary tip, but compensation policies vary by restaurant, platform, worker arrangement, and location.
        Check the restaurant or app's disclosure if you need to know how a specific fee is used.
      </p>

      <h3>What about rain, distance, stairs, or a difficult order?</h3>
      <p>
        It is reasonable to choose a higher amount when a delivery requires more work or difficulty, but there is no
        universal mileage or bad-weather surcharge that this site can state as fact. Emily Post's pizza-delivery
        guidance explicitly varies with order size and delivery difficulty.
      </p>

      <h3>Cash or in-app?</h3>
      <p>
        Use a payment method the restaurant or platform supports and that works for you. Policies differ, so this site
        does not promise a particular payout outcome for cash or assume that every in-app fee is distributed the same
        way.
      </p>

      <h3>What does survey data tell us?</h3>
      <p>
        Pew Research Center's 2023 survey found that 76% of U.S. adults who have food delivered said they always or
        often tip in that situation. That measures <strong>how often respondents say they tip</strong>; it does not
        establish what percentage they leave on an order.
      </p>
    </div>
  </section>

  <AdSlot format="leaderboard" position="inline" id="ad-content-1" />

  <section class="section" id="faq">
    <h2>Delivery tipping questions, answered</h2>
    <div class="faq">
      <details>
        <summary>Should I calculate a percentage tip on the delivery fee?</summary>
        <p>
          This calculator keeps the delivery fee outside the percentage tip basis and adds it to the final total.
          That is a calculator choice, not a claim about every platform's compensation policy. You can always enter a
          custom dollar tip if you prefer.
        </p>
      </details>
      <details>
        <summary>What is a commonly recommended delivery tip?</summary>
        <p>
          Emily Post currently recommends 10–15% of the bill for delivery and $2–5 for pizza delivery depending on
          order size and difficulty. Other guides and personal choices can differ.
        </p>
      </details>
      <details>
        <summary>Does a service fee go to the driver?</summary>
        <p>
          You cannot tell from the fee name alone. Platform and restaurant policies vary. Check the specific
          disclosure instead of assuming the fee either goes entirely to the driver or entirely to the platform.
        </p>
      </details>
      <details>
        <summary>Should I tip more for a difficult delivery?</summary>
        <p>
          You may. Order size and delivery difficulty are reasonable factors to consider, and Emily Post explicitly
          varies its pizza-delivery dollar guidance by those factors. There is no universal dollar surcharge for rain
          or distance.
        </p>
      </details>
      <details>
        <summary>How do I split a group delivery order?</summary>
        <p>
          Enter every amount that the group owes, choose the tip, and set the number of people. The calculator
          reconciles odd cents exactly; the optional whole-dollar round-up shows any extra money collected separately.
        </p>
      </details>
    </div>
  </section>

  <section class="section" id="sources">
    <h2>Sources</h2>
    <ul class="prose">
      <li>
        <a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a>
        — delivery etiquette recommendations.
      </li>
      <li>
        <a href={SOURCES.pewTipping}>Pew Research Center — Services Americans do and don't tip for, and how much</a>
        (November 9, 2023) — stated tipping frequency for food delivery and other services.
      </li>
    </ul>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. Platform compensation policies can change independently of this
      guide.
    </p>
  </section>

  <AdSlot format="native" position="inline" id="ad-native" />

  <Related exclude="/food-delivery-tip-calculator/" />
</Layout>
