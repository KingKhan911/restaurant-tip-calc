---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';
import { RESEARCH_REVIEW_DATE, SOURCES } from '../lib/editorial.js';

const title = 'Average Restaurant Tip in the U.S.: Current Data & Tipping Ranges';
const description =
  'Compare current restaurant tipping data from Toast, Pew survey responses, and etiquette guidance without confusing observed behavior with recommendations.';

const nav = [
  { href: '#evidence', label: 'Current data' },
  { href: '#calculator', label: 'Calculator' },
  { href: '#faq', label: 'FAQ' },
  { href: '#sources', label: 'Sources' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Restaurant Tip Calculator',
          item: 'https://restauranttipcalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Average Restaurant Tip',
          item: 'https://restauranttipcalculator.com/average-restaurant-tip/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#app',
      url: 'https://restauranttipcalculator.com/average-restaurant-tip/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Percentage presets, custom percentage, and custom dollar tip',
        'Tax and other fee inputs',
        'Optional choice to include entered tax in the percentage tip basis',
        'Exact cent-reconciled bill splitting for up to 99 people',
        'Optional whole-dollar round-up with the extra amount shown',
      ],
    },
  ],
});
---

<Layout title={title} description={description} path="/average-restaurant-tip/" jsonLd={jsonLd} nav={nav}>
  <section class="hero">
    <p class="guide-intro"><a href="/">Restaurant tip calculator</a> / Restaurant tipping data</p>
    <h1>Average Restaurant Tip in the U.S.: What Current Data Shows</h1>
    <p class="lede">
      There is no single number that describes every U.S. restaurant tip. <strong>Toast's latest published platform
      data, for Q1 2026, reports a 19.3% average at full-service restaurants</strong> and 15.8% at quick-service
      restaurants. Pew's 2023 survey asked a different question and found that 57% of adults would leave 15% or less
      for an average, non-exceptional sit-down meal.
    </p>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. This page separates observed transactions, stated survey
      behavior, and etiquette recommendations.
    </p>
  </section>

  <section class="section" id="evidence">
    <h2>What does the average restaurant tip data actually show?</h2>
    <table class="worked">
      <caption>Three different kinds of tipping evidence</caption>
      <thead>
        <tr>
          <th scope="col">Evidence type</th>
          <th scope="col">Current finding</th>
          <th scope="col">What it measures</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Observed transactions — Toast, Q1 2026</td>
          <td>19.3% full-service; 15.8% quick-service; 18.8% overall; 13.7% takeout</td>
          <td>Tip data from applicable card and digital payments at restaurants on the Toast platform; cash tips are excluded.</td>
        </tr>
        <tr>
          <td>Stated behavior — Pew, 2023</td>
          <td>57% said 15% or less; 12% said 18%; 25% said 20% or more</td>
          <td>What U.S. adults said they would tip in a hypothetical sit-down meal with average, non-exceptional food and service.</td>
        </tr>
        <tr>
          <td>Etiquette recommendation — Emily Post</td>
          <td>15–20% pre-tax for sit-down wait service</td>
          <td>Guidance about what diners may choose to do; it is not a measurement of population behavior.</td>
        </tr>
      </tbody>
    </table>

    <div class="prose">
      <h3>Toast: observed card and digital tipping</h3>
      <p>
        <a href={SOURCES.toastTipping}>Toast's Restaurant Tipping Trends</a>, last updated June 24, 2026 with Q1 2026
        data, reports average tips of <strong>19.3% at full-service restaurants</strong>,
        <strong>15.8% at quick-service restaurants</strong>, and <strong>18.8% overall</strong>. Toast's separate
        takeout figure for Q1 2026 is <strong>13.7%</strong>.
      </p>
      <p>
        Toast says these figures come from aggregated card and digital tip transactions at restaurants on its
        platform, which served roughly 171,000 locations as of March 31, 2026. <strong>Cash tips are not included.</strong>
        The figures therefore should not be described as every tip left by every U.S. diner.
      </p>

      <h3>Pew: what people said they would tip in a specific scenario</h3>
      <p>
        <a href={SOURCES.pewTipping}>Pew Research Center's November 2023 report</a> gave respondents a hypothetical
        sit-down restaurant scenario with <strong>average, but not exceptional, food and service</strong>. In that
        scenario, 57% said they would tip 15% or less, including 2% who would leave no tip; 12% chose 18%; and 25%
        chose 20% or more.
      </p>
      <p>
        That does not support the old claim that Pew found "most Americans tip around 20%." It measures stated intent
        in one hypothetical scenario, not actual restaurant transactions.
      </p>

      <h3>Why can Toast and Pew both be accurate?</h3>
      <p>
        They are measuring different things. Toast observes qualifying card and digital transactions on its own
        restaurant platform. Pew asked U.S. adults what they would do in a defined hypothetical sit-down meal. Cash
        is absent from Toast's dataset, and the service/payment contexts and sampled populations are not the same.
        Those methodological differences are enough to explain why the numbers should not be expected to match; this
        site does not invent a causal story beyond what the sources show.
      </p>

      <h3>What is a normal, customary, or standard restaurant tip?</h3>
      <p>
        Those words often refer to <strong>etiquette guidance</strong> rather than a measured average. Emily Post
        recommends 15–20% of the pre-tax bill for sit-down wait service. It is more accurate to call that a recommended
        range than to say "20% is what most Americans tip." For a practical service-by-service decision, see
        <a href="/how-much-tip-waitress-waiter/">how much to tip a waiter or waitress</a>.
      </p>
    </div>
  </section>

  <Calculator mode="dinein" />

  <aside class="ad ad-leaderboard ad-below" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-below" data-size="728 × 90 · 300 × 250">
      <!-- e.g. GAM slot: /XXXXXXX/rtc_avgptip_below-calc -->
    </div>
  </aside>

  <section class="section" id="wage-context">
    <h2>Does the federal $2.13 tipped cash wage apply to every server?</h2>
    <div class="prose">
      <p>
        <strong>No.</strong> Under the federal FLSA tip-credit framework, an employer taking a tip credit must pay at
        least $2.13 per hour in direct cash wages and ensure that direct wages plus tips meet at least the federal
        minimum-wage obligation; if they do not, the employer must make up the difference.
      </p>
      <p>
        State law can require a higher direct cash wage or prohibit this kind of tip credit. The
        <a href={SOURCES.dolTippedWages}>U.S. Department of Labor's tipped-wage table</a> shows the state-by-state
        variation. That is why this site does not describe $2.13 as the wage that all U.S. restaurant servers earn.
      </p>
    </div>
  </section>

  <section class="section" id="faq">
    <h2>Average restaurant tip questions, answered</h2>
    <div class="faq">
      <details>
        <summary>What is the average restaurant tip in the U.S.?</summary>
        <p>
          It depends on the dataset and restaurant type. Toast's latest published U.S. platform data for Q1 2026
          reports 19.3% at full-service restaurants, 15.8% at quick-service restaurants, and 18.8% overall among its
          applicable card and digital tip data. Cash tips are excluded.
        </p>
      </details>
      <details>
        <summary>Did Pew find that most Americans tip 20%?</summary>
        <p>
          No. In Pew's 2023 hypothetical average sit-down meal, 57% said they would tip 15% or less, 12% chose 18%,
          and 25% chose 20% or more.
        </p>
      </details>
      <details>
        <summary>Is 20% a standard restaurant tip?</summary>
        <p>
          As etiquette, 20% sits within Emily Post's 15–20% pre-tax range for sit-down wait service. That is a
          recommendation, not proof that most diners leave exactly 20%.
        </p>
      </details>
      <details>
        <summary>What is the average takeout tip?</summary>
        <p>
          Toast reports a 13.7% takeout average for Q1 2026 in its applicable card and digital data. That is observed
          platform data, not a recommendation that every takeout customer should tip 13.7%.
        </p>
      </details>
      <details>
        <summary>Should a percentage tip be calculated before or after tax?</summary>
        <p>
          Emily Post states its sit-down guidance on the pre-tax amount. The calculator defaults to excluding entered
          tax from the percentage tip basis, but you can switch on the option to include tax if you prefer.
        </p>
      </details>
    </div>
  </section>

  <section class="section" id="sources">
    <h2>Sources and data periods</h2>
    <ul class="prose">
      <li>
        <a href={SOURCES.toastTipping}>Toast — Restaurant Tipping Trends</a>
        — Q1 2026 data; page last updated June 24, 2026. Card and digital tip transactions; cash excluded.
      </li>
      <li>
        <a href={SOURCES.pewTipping}>Pew Research Center — Services Americans do and don't tip for, and how much</a>
        — published November 9, 2023; hypothetical average, non-exceptional sit-down dining question.
      </li>
      <li>
        <a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a>
        — current etiquette recommendations for sit-down, buffet, delivery, takeout and other services.
      </li>
      <li>
        <a href={SOURCES.dolFactSheet15}>U.S. Department of Labor — Fact Sheet #15: Tipped Employees Under the FLSA</a>
        — federal tip-credit framework.
      </li>
      <li>
        <a href={SOURCES.dolTippedWages}>U.S. Department of Labor — Minimum Wages for Tipped Employees</a>
        — state variation in direct cash wages and tip-credit rules.
      </li>
    </ul>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. <a href="/methodology/">Read our source-selection methodology.</a>
    </p>
  </section>

  <aside class="ad ad-native ad-inline" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-native" data-size="Native banner · 280px reserved">
      <!-- Paste the native banner tag from your ad network here -->
    </div>
  </aside>

  <Related exclude="/average-restaurant-tip/" />
</Layout>
