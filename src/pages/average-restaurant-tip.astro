---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';

const title = 'Average Restaurant Tip: What Percentage is Standard in the US (15–20%)';
const description =
  'The average restaurant tip in the U.S. is 15–20% of the pre-tax bill, with 20% now the standard for full table service. See the data, per-service breakdown, and tip math.';

const nav = [
  { href: '#calculator', label: 'Calculator' },
  { href: '#average', label: 'The numbers' },
  { href: '#faq', label: 'FAQ' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Restaurant Tip Calculator',
          item: 'https://restauranttipcalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Average Restaurant Tip',
          item: 'https://restauranttipcalculator.com/average-restaurant-tip/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#app',
      url: 'https://restauranttipcalculator.com/average-restaurant-tip/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Tip percentage presets (15%, 18%, 20%, 22%) and custom tip',
        'Instant tip amount and total with tip',
        'Split the bill between up to 99 people',
        'No sign-up; all calculations run in the browser',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#howto',
      url: 'https://restauranttipcalculator.com/average-restaurant-tip/#calculator',
      name: 'How to calculate your restaurant tip',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Enter the bill',
          text: 'Type the amount from your check. Everything updates as you type.',
        },
        {
          '@type': 'HowToStep',
          name: 'Choose a tip',
          text: 'Tap 15, 18, 20, or 22 percent, or type a custom percentage like 17.5.',
        },
        {
          '@type': 'HowToStep',
          name: 'Split it',
          text: 'Set how many people are paying and read the per-person amount.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://restauranttipcalculator.com/average-restaurant-tip/#faq',
      url: 'https://restauranttipcalculator.com/average-restaurant-tip/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the average restaurant tip in the U.S.?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Most U.S. diners tip between 15% and 20% of the pre-tax bill, and 20% has become the norm for full table service. Counter and fast-casual orders average under 10%, while full-service check averages land near 19–20% in industry point-of-sale data (Toast, 2023).',
          },
        },
        {
          '@type': 'Question',
          name: 'What percentage is customary for tipping in a restaurant?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The customary tip for restaurant table service is 15–20% of the pre-tax amount: 15–18% for adequate service and 20% or more for good-to-great service. Etiquette guides have quoted 18–20% for decades, and that same range is the standard restaurant tip today.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is 20% now the standard restaurant tip?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes — 20% is widely treated as the default for full-service table service in the U.S., with 18% seen as slightly conservative and 22–25% for exceptional service. A 2023 Pew Research survey found most Americans tip about 20% at sit-down restaurants.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a normal restaurant tip for average or bad service?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For average or merely acceptable service, 15–18% is normal. For poor service, diners commonly drop to 10% rather than zero — the tipped minimum wage is as low as $2.13 an hour, so zeroing the tip pulls money directly out of the server\'s pay. For clearly hostile service, speak to a manager instead of leaving nothing silently.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the average tip on a $50 restaurant bill?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'At 18%, the tip on a $50 bill is $9.00 for a total of $59.00. At 20%, it is $10.00 for a total of $60.00. Split between two people, that is $29.50 or $30.00 each.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you tip before or after tax?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Etiquette says calculate the percentage on the pre-tax subtotal. Most people just tip on the after-tax total because it is the number at the bottom of the check — the difference is usually well under a dollar, so either approach is fine as long as you are consistent.',
          },
        },
      ],
    },
  ],
