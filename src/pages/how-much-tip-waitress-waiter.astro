---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';

const title = 'How Much to Tip a Waitress or Waiter: 15–20% Guide with Examples';
const description =
  'Tip a waitress or waiter 15–20% of the pre-tax bill: 15% for adequate service, 20% for good service, 22–25% for great. Plus per-check examples and when to tip more or less.';

const nav = [
  { href: '#calculator', label: 'Calculator' },
  { href: '#guide', label: 'Guide' },
  { href: '#faq', label: 'FAQ' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Restaurant Tip Calculator',
          item: 'https://restauranttipcalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'How Much to Tip a Waitress or Waiter',
          item: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#app',
      url: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Tip percentage presets (15%, 18%, 20%, 22%) and custom tip',
        'Instant tip amount and total with tip',
        'Split the bill between up to 99 people',
        'No sign-up; all calculations run in the browser',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#howto',
      url: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#calculator',
      name: 'How to calculate your waiter tip',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Enter the bill',
          text: 'Type the amount from your check. Everything updates as you type.',
        },
        {
          '@type': 'HowToStep',
          name: 'Choose a tip',
          text: 'Tap 15, 18, 20, or 22 percent, or type a custom percentage like 17.5.',
        },
        {
          '@type': 'HowToStep',
          name: 'Split it',
          text: 'Set how many people are paying and read the per-person amount.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#faq',
      url: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How much should you tip a waitress or waiter?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Tip your waiter or waitress 15–20% of the pre-tax bill for table service: 15% for adequate but unremarkable service, 18% for good service, and 20–25% for great or exceptional service. Below 15% signals that something went wrong.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is the average tip for waiters and waitresses?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'The average tip for waiters and waitresses in the U.S. is about 20% of the bill at full-service restaurants, with the standard range between 15% and 20%. Industry point-of-sale data puts full-service averages just under 20%.',
          },
        },
        {
          '@type': 'Question',
          name: 'How much tip do you leave on a $40 restaurant bill?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'On a $40 bill: 15% is $6.00, 18% is $7.20, 20% is $8.00 and a 22% tip is $8.80. Most people would leave $8.00 for good service — $48.00 total.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you tip a waiter per drink or on the full check?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Tip on the full check — drinks included — or leave $1–2 per drink at the bar. If your server also makes your drinks and the tab is mainly alcohol, 15–20% of the whole check still works.',
          },
        },
        {
          '@type': 'Question',
          name: 'Do you still tip when a gratuity is already added?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No — if an automatic gratuity of 18–20% is already on the check (common for parties of six or more), that is the tip. Adding a small extra for standout service is optional and always welcome.',
          },
        },
        {
          '@type': 'Question',
          name: 'Should you tip more than 20%?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, when service went above and beyond — attentive pacing, accommodated requests, strong recommendations, difficult seating or a large mobile order. 22–25% is a fair way to say thank you, and exceptional service at high-end restaurants commonly earns it.',
          },
        },
