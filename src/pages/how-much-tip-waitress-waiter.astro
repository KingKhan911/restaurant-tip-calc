---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';
import { RESEARCH_REVIEW_DATE, SOURCES } from '../lib/editorial.js';

const title = 'How Much Should You Tip a Waiter or Waitress? U.S. Guide';
const description =
  'Practical U.S. table-service tipping guidance for ordinary service, exceptional service, problems, automatic gratuities and bill splitting.';

const nav = [
  { href: '#calculator', label: 'Calculator' },
  { href: '#guide', label: 'Guide' },
  { href: '#wages', label: 'Wage context' },
  { href: '#faq', label: 'FAQ' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Restaurant Tip Calculator',
          item: 'https://restauranttipcalculator.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'How Much to Tip a Waiter or Waitress',
          item: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/',
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/#app',
      url: 'https://restauranttipcalculator.com/how-much-tip-waitress-waiter/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Percentage presets, custom percentage, and custom dollar tip',
        'Tax and other fee inputs',
        'Optional choice to include entered tax in the percentage tip basis',
        'Exact cent-reconciled bill splitting for up to 99 people',
        'Optional whole-dollar round-up with the extra amount shown',
      ],
    },
  ],
});
---

<Layout title={title} description={description} path="/how-much-tip-waitress-waiter/" jsonLd={jsonLd} nav={nav}>
  <section class="hero">
    <p class="guide-intro"><a href="/">Restaurant tip calculator</a> / Table-service guidance</p>
    <h1>How Much Should You Tip a Waiter or Waitress?</h1>
    <p class="lede">
      For U.S. sit-down wait service, <strong>Emily Post recommends 15–20% of the pre-tax bill</strong>. That is
      etiquette guidance, not a statistic saying every diner tips the same amount. You can choose more for exceptional
      service, and a service problem deserves context rather than an automatic formula.
    </p>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. For observed and survey data, see the
      <a href="/average-restaurant-tip/">average restaurant tip evidence page</a>.
    </p>
  </section>

  <Calculator mode="dinein" />

  <aside class="ad ad-leaderboard ad-below" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-below" data-size="728 × 90 · 300 × 250">
      <!-- e.g. GAM slot: /XXXXXXX/rtc_waiter_below-calc -->
    </div>
  </aside>

  <section class="section" id="guide">
    <h2>Practical table-service tipping decisions</h2>
    <div class="guide-grid">
      <div>
        <p class="guide-intro">
          Use the range as a starting point, then consider what actually happened at the table.
        </p>
        <div class="menu">
          <div class="menu-row">
            <span class="menu-name">Sit-down wait service</span><span class="dots" aria-hidden="true"></span><span class="menu-val">15–20% pre-tax guidance</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Exceptional service</span><span class="dots" aria-hidden="true"></span><span class="menu-val">More is optional</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Automatic gratuity already added</span><span class="dots" aria-hidden="true"></span><span class="menu-val">Check before adding another full tip</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Service problem</span><span class="dots" aria-hidden="true"></span><span class="menu-val">Consider cause; speak to manager if needed</span>
          </div>
        </div>
        <p class="menu-src">
          Etiquette source: <a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a>.
        </p>
      </div>
      <div>
        <table class="worked">
          <caption>Tip math on a $60 pre-tax bill</caption>
          <thead>
            <tr><th scope="col">Rate</th><th scope="col">Tip</th><th scope="col">Subtotal + tip</th></tr>
          </thead>
          <tbody>
            <tr><td>15%</td><td>$9.00</td><td>$69.00</td></tr>
            <tr><td>18%</td><td>$10.80</td><td>$70.80</td></tr>
            <tr><td>20%</td><td>$12.00</td><td>$72.00</td></tr>
            <tr><td>22%</td><td>$13.20</td><td>$73.20</td></tr>
          </tbody>
        </table>
        <p class="worked-note">
          The first three percentages show common calculator choices; 22% is included as arithmetic, not as a claim
          that etiquette requires it. <a href="#calculator">Use your own amount above.</a>
        </p>
      </div>
    </div>

    <div class="prose">
      <h3>What if the service was excellent?</h3>
      <p>
        Tipping above your usual amount is a voluntary way to recognize exceptional service. There is no need for this
        site to invent a universal "exceptional service" percentage; the calculator accepts any percentage or exact
        dollar amount.
      </p>

      <h3>What if something went wrong?</h3>
      <p>
        First separate the server's work from problems they may not control, such as a kitchen delay, unavailable
        items, or a restaurant policy. If the problem is serious, speaking with a manager is often more useful than
        trying to communicate everything through a percentage alone.
      </p>

      <h3>What if a charge is already on the check?</h3>
      <p>
        If the bill clearly includes an automatic gratuity, do not add another full gratuity automatically. If it says
        only service fee, hospitality fee, wellness fee, or something similar, read the restaurant's disclosure
        instead of guessing by the percentage. See the
        <a href="/service-charge-on-restaurant-bill/">service-charge guide</a>.
      </p>

      <h3>Pre-tax or after-tax?</h3>
      <p>
        Emily Post's sit-down recommendation is stated on the <strong>pre-tax amount</strong>. That is etiquette
        guidance, not law. The calculator defaults to a percentage tip basis that excludes entered tax, and its More
        options section lets you include tax in the percentage basis if that is how you prefer to calculate.
      </p>
    </div>
  </section>

  <section class="section" id="wages">
    <h2>What the $2.13 federal tipped-wage figure does — and does not — mean</h2>
    <div class="prose">
      <p>
        The <a href={SOURCES.dolFactSheet15}>U.S. Department of Labor's FLSA guidance</a> says an employer using the
        federal tip-credit framework must pay a tipped worker at least $2.13 per hour in direct cash wages and ensure
        that direct wages plus tips reach at least the applicable federal minimum-wage obligation. If they do not, the
        employer must make up the difference.
      </p>
      <p>
        That does <strong>not</strong> mean every U.S. server earns $2.13 an hour. State laws can require a higher
        direct wage or prohibit this style of tip credit. The Department of Labor's
        <a href={SOURCES.dolTippedWages}>state tipped-wage table</a> shows substantial variation.
      </p>
      <p>
        Wage rules help explain the U.S. tipping system, but this page does not use them to claim that a customer's tip
        is literally "most of every server's paycheck." Earnings and wage rules vary by worker and location.
      </p>
    </div>
  </section>

  <section class="section" id="faq">
    <h2>Waiter and waitress tipping questions, answered</h2>
    <div class="faq">
      <details>
        <summary>How much should you tip a waiter or waitress?</summary>
        <p>
          Emily Post recommends 15–20% of the pre-tax bill for U.S. sit-down wait service. It is an etiquette range,
          not a measured average of every diner.
        </p>
      </details>
      <details>
        <summary>Is 20% the average tip for servers?</summary>
        <p>
          Do not mix an etiquette target with a measured average. Toast's Q1 2026 card-and-digital data found a 19.3%
          average at full-service restaurants on its platform. Pew's 2023 hypothetical survey produced a different
          distribution. <a href="/average-restaurant-tip/">See the data and methodology side by side.</a>
        </p>
      </details>
      <details>
        <summary>Should I tip more than 20% for exceptional service?</summary>
        <p>
          You can, but it is voluntary. Rather than prescribe a universal number, use the amount that reflects your
          experience and budget.
        </p>
      </details>
      <details>
        <summary>Do I tip again when gratuity is already added?</summary>
        <p>
          If the bill clearly identifies an automatic gratuity, do not add another full gratuity automatically. Extra
          tipping is voluntary. A generic service fee requires a closer look at the restaurant's disclosure.
        </p>
      </details>
    </div>
  </section>

  <section class="section" id="sources">
    <h2>Sources</h2>
    <ul class="prose">
      <li><a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a> — sit-down wait-service etiquette.</li>
      <li><a href={SOURCES.dolFactSheet15}>U.S. Department of Labor — Fact Sheet #15</a> — federal tipped-employee rules.</li>
      <li><a href={SOURCES.dolTippedWages}>U.S. Department of Labor — Minimum Wages for Tipped Employees</a> — state variation.</li>
    </ul>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. <a href="/methodology/">See source-selection and calculation methodology.</a>
    </p>
  </section>

  <aside class="ad ad-native ad-inline" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-native" data-size="Native banner · 280px reserved">
      <!-- Paste the native banner tag from your ad network here -->
    </div>
  </aside>

  <Related exclude="/how-much-tip-waitress-waiter/" />
</Layout>
