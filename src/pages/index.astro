---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';
import { RESEARCH_REVIEW_DATE, SOURCES } from '../lib/editorial.js';

const title = 'Restaurant Tip Calculator: Tip, Total & Split the Bill';
const description =
  'Calculate a restaurant tip by percentage or custom dollar amount, add tax and fees, split the bill exactly, and optionally round each share up.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://restauranttipcalculator.com/#website',
      url: 'https://restauranttipcalculator.com/',
      name: 'Restaurant Tip Calculator',
      inLanguage: 'en',
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/#app',
      url: 'https://restauranttipcalculator.com/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      isPartOf: { '@id': 'https://restauranttipcalculator.com/#website' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Percentage presets, custom percentage, and custom dollar tip',
        'Tax and other fee inputs',
        'Optional choice to include entered tax in the percentage tip basis',
        'Exact cent-reconciled bill splitting for up to 99 people',
        'Optional whole-dollar round-up with the extra amount shown',
        'No sign-up; calculations run in the browser',
      ],
    },
  ],
});
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Restaurant Tip Calculator</h1>
    <p class="lede">
      Enter your check, choose a percentage or exact dollar tip, and split the total. Add tax or other fees when they
      apply; the calculator shows the tip, payable total, and exact per-person shares as you type.
    </p>
  </section>

  <Calculator mode="dinein" />

  <aside class="ad ad-leaderboard ad-below" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-below" data-size="728 × 90 · 300 × 250">
      <!-- e.g. GAM slot: /XXXXXXX/rtc_below-calc -->
    </div>
  </aside>

  <section class="section" id="how-it-works">
    <h2>How to calculate a restaurant tip and total</h2>
    <ol class="steps">
      <li>
        <span class="step-n" aria-hidden="true">1.</span><p>
          <strong>Enter the bill amount.</strong> Add tax and any other fee under More options if you want those amounts
          included in the payable total.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">2.</span><p>
          <strong>Choose the tip.</strong> Use 15%, 18%, 20%, 22%, a custom percentage, or an exact custom dollar tip.
          Percentage tips exclude entered tax by default; you can choose to include tax in the tip basis.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">3.</span><p>
          <strong>Split the bill.</strong> Set 1–99 people. If the total cannot divide evenly to the cent, the
          calculator shows exactly how many people pay each cent-reconciled share. Whole-dollar round-up is optional.
        </p>
      </li>
    </ol>
  </section>

  <section class="section" id="tipping-guide">
    <h2>What percentage should you tip at a restaurant?</h2>
    <div class="guide-grid">
      <div>
        <p class="guide-intro">
          For U.S. sit-down wait service, <strong>Emily Post recommends 15–20% of the pre-tax bill</strong>. That is an
          etiquette recommendation, not a claim that every diner leaves the same amount.
        </p>
        <div class="menu">
          <div class="menu-row">
            <span class="menu-name">Sit-down wait service — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">15–20% pre-tax</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Buffet wait service — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">10% pre-tax</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Food delivery — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">10–15%</span>
          </div>
        </div>
        <p class="menu-src">
          Source: <a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a>. For measured restaurant tipping,
          see the <a href="/average-restaurant-tip/">average restaurant tip data page</a>.
        </p>
      </div>
      <div>
        <table class="worked">
          <caption>A $60 bill at common calculator percentages</caption>
          <thead>
            <tr><th scope="col">Tip</th><th scope="col">Tip amount</th><th scope="col">Bill + tip</th></tr>
          </thead>
          <tbody>
            <tr><td>15%</td><td>$9.00</td><td>$69.00</td></tr>
            <tr><td>18%</td><td>$10.80</td><td>$70.80</td></tr>
            <tr><td>20%</td><td>$12.00</td><td>$72.00</td></tr>
            <tr><td>22%</td><td>$13.20</td><td>$73.20</td></tr>
          </tbody>
        </table>
        <p class="worked-note">
          These are arithmetic examples. Tax and other fees, if entered, are added to the final total separately.
        </p>
      </div>
    </div>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. <a href="/methodology/">How we separate data from recommendations.</a>
    </p>
  </section>

  <aside class="ad ad-leaderboard ad-inline" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-content-1" data-size="728 × 90 · 300 × 250">
      <!-- e.g. GAM slot: /XXXXXXX/rtc_in-content -->
    </div>
  </aside>

  <section class="section" id="tip-on-tax">
    <h2>Do you tip before tax or after tax?</h2>
    <div class="prose">
      <p>
        Many etiquette guides state percentage recommendations on the <strong>pre-tax subtotal</strong>; Emily Post's
        sit-down guidance is one example. That is a convention, not a law. Some diners prefer to use the final amount
        shown on the check instead.
      </p>
      <p>
        This calculator makes the choice explicit. Enter tax under More options. A percentage tip excludes that entered
        tax by default; switch on <strong>Include tax in percentage tip basis</strong> if you want the percentage
        applied to bill plus tax. Other fees remain outside the percentage tip basis.
      </p>
      <p>
        Example: on a $60 bill with $4.80 tax, a 20% pre-tax tip is $12.00. If tax is included in the tip basis, the
        same 20% becomes $12.96. The final payable total also includes the $4.80 tax in either case.
      </p>
    </div>
  </section>

  <section class="section" id="service-charges">
    <h2>What if the restaurant bill already has a service charge?</h2>
    <div class="prose">
      <p>
        <strong>Do not decide from the percentage alone.</strong> If the bill clearly identifies an automatic
        gratuity, do not add a second full gratuity automatically. A generic service, hospitality, wellness, or
        administrative fee may work differently. Read the restaurant's disclosure or ask how the charge is treated
        before adding another full tip.
      </p>
      <p>
        See the <a href="/service-charge-on-restaurant-bill/">service-charge guide</a> for the IRS distinction between
        mandatory charges and voluntary tips, plus a practical decision framework.
      </p>
    </div>
  </section>

  <section class="section" id="faq">
    <h2>Restaurant tipping questions, answered</h2>
    <div class="faq">
      <details>
        <summary>How much do you tip on a $50 restaurant bill?</summary>
        <p>
          A 15% tip is $7.50, 18% is $9.00, and 20% is $10.00. Before tax or other fees, those produce totals of
          $57.50, $59.00, and $60.00 respectively.
        </p>
      </details>
      <details>
        <summary>What is the average restaurant tip?</summary>
        <p>
          It depends on what is being measured. Toast's latest published Q1 2026 platform data reports a 19.3%
          full-service average among its applicable card and digital tip transactions; cash is excluded. Pew's 2023
          stated-behavior survey found a different distribution. <a href="/average-restaurant-tip/">See both sources and their limitations.</a>
        </p>
      </details>
      <details>
        <summary>How much should you tip a waiter or waitress?</summary>
        <p>
          Emily Post recommends 15–20% of the pre-tax bill for U.S. sit-down wait service. For service problems,
          exceptional service, or a charge already on the check, see the
          <a href="/how-much-tip-waitress-waiter/">practical server tipping guide</a>.
        </p>
      </details>
      <details>
        <summary>How much should you tip at a buffet?</summary>
        <p>
          Emily Post recommends 10% pre-tax for buffet wait service. Buffet formats vary, so the
          <a href="/buffet-tipping-guide/">buffet guide</a> explains how table service changes the decision without
          pretending there is one measured national buffet average.
        </p>
      </details>
      <details>
        <summary>How much should you tip for food delivery?</summary>
        <p>
          Emily Post recommends 10–15% for delivery and gives $2–5 as pizza-delivery guidance depending on order size
          and difficulty. The <a href="/food-delivery-tip-calculator/">delivery calculator</a> accepts any percentage
          or custom dollar amount and keeps delivery fees separate from the percentage tip basis.
        </p>
      </details>
      <details>
        <summary>How do you split a restaurant bill when the cents do not divide evenly?</summary>
        <p>
          The calculator reconciles the exact total to the cent. For example, if $10.00 is split three ways, one person
          pays $3.34 and two pay $3.33. The optional round-up mode is different: it raises each share to a whole dollar
          and clearly shows the extra money collected.
        </p>
      </details>
    </div>
  </section>

  <section class="section" id="research">
    <h2>Research behind the guidance</h2>
    <ul class="prose">
      <li><a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a> for etiquette recommendations.</li>
      <li><a href={SOURCES.toastTipping}>Toast — Restaurant Tipping Trends</a> for Q1 2026 observed card/digital restaurant tipping data.</li>
      <li><a href={SOURCES.pewTipping}>Pew Research Center — 2023 tipping survey</a> for stated consumer behavior.</li>
    </ul>
    <p class="menu-src">
      See <a href="/methodology/">Methodology</a> for calculation rules, source hierarchy, research freshness, and
      limitations.
    </p>
  </section>

  <aside class="ad ad-native ad-inline" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <div class="ad-slot" id="ad-native" data-size="Native banner · 280px reserved">
      <!-- Paste the native banner tag from your ad network here -->
    </div>
  </aside>

  <Related exclude="/" />
</Layout>
