---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import Related from '../components/Related.astro';
import AdSlot from '../components/AdSlot.astro';
import { RESEARCH_REVIEW_DATE, SOURCES } from '../lib/editorial.js';

const title = 'Restaurant Tip Calculator: Tip, Total & Split the Bill';
const description =
  'Calculate a restaurant tip by percentage or custom amount, add tax and fees, split the bill exactly, and use your preferred supported currency.';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://restauranttipcalculator.com/#website',
      url: 'https://restauranttipcalculator.com/',
      name: 'Restaurant Tip Calculator',
      inLanguage: 'en',
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://restauranttipcalculator.com/#app',
      url: 'https://restauranttipcalculator.com/',
      name: 'Restaurant Tip Calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      isPartOf: { '@id': 'https://restauranttipcalculator.com/#website' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Percentage presets, custom percentage, and custom tip amount',
        'User-selected display currency: USD, CAD, GBP, EUR, AUD, NZD, ZAR, INR, AED',
        'Currency changes display only; no exchange-rate conversion',
        'Tax and other fee inputs',
        'Optional choice to include entered tax in the percentage tip basis',
        'Exact cent-reconciled bill splitting for up to 99 people',
        'Optional whole-currency-unit round-up with the extra amount shown',
        'No sign-up; calculations run in the browser',
      ],
    },
  ],
});
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Restaurant Tip Calculator</h1>
    <p class="lede">
      Enter your check, choose a percentage or custom tip amount, select a supported currency, and split the total.
      The arithmetic is the same in every supported currency; tipping customs vary by country, so local etiquette
      should be checked separately.
    </p>
  </section>

  <Calculator mode="dinein" currencySelector />

  <AdSlot format="leaderboard" position="below" id="ad-below" />

  <section class="section" id="how-it-works">
    <h2>How to calculate a restaurant tip and total</h2>
    <ol class="steps">
      <li>
        <span class="step-n" aria-hidden="true">1.</span><p>
          <strong>Enter the bill amount.</strong> Add tax and any other fee under More options if you want those amounts
          included in the payable total.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">2.</span><p>
          <strong>Choose the tip.</strong> Use 15%, 18%, 20%, 22%, a custom percentage, or an exact custom tip amount.
          Percentage tips exclude entered tax by default; you can choose to include tax in the tip basis.
        </p>
      </li>
      <li>
        <span class="step-n" aria-hidden="true">3.</span><p>
          <strong>Split the bill.</strong> Set 1–99 people. If the total cannot divide evenly to the cent, the
          calculator shows exactly how many people pay each cent-reconciled share. Whole-currency-unit round-up is optional.
        </p>
      </li>
    </ol>
  </section>


  <section class="section" id="country-guidance">
    <h2>Tipping customs vary by country</h2>
    <p class="guide-intro">
      The calculator works the same way in every supported currency, but restaurant tipping expectations are local.
      Check the bill for any service charge and use country-specific guidance rather than assuming one worldwide tip
      percentage.
    </p>
    <div class="table-scroll">
      <table class="worked worked-wide country-table">
        <caption>Restaurant tipping context in major English-language markets</caption>
        <thead>
          <tr><th scope="col">Country</th><th scope="col">Restaurant tipping context</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>United States</td>
            <td><a href={SOURCES.emilyPost}>Emily Post</a> recommends 15–20% of the pre-tax bill for sit-down wait service.</td>
          </tr>
          <tr>
            <td>Canada</td>
            <td><a href={SOURCES.canadaGratuities}>Canada Revenue Agency</a> says tips or service charges are not usually added to a bill and customers generally tip a percentage; the amount depends on the customer.</td>
          </tr>
          <tr>
            <td>United Kingdom</td>
            <td><a href={SOURCES.visitBritain}>VisitBritain</a> says tipping is not necessary; if no service charge is added and service was good, 10–15% is well received.</td>
          </tr>
          <tr>
            <td>Australia</td>
            <td><a href={SOURCES.tourismAustralia}>Tourism Australia</a> says tipping is always your choice; in upmarket restaurants, 10% is common for good service.</td>
          </tr>
          <tr>
            <td>New Zealand</td>
            <td><a href={SOURCES.tourismNewZealand}>Tourism New Zealand</a> says tipping is not obligatory, tipping for good service is discretionary, and hotels and restaurants do not add service charges.</td>
          </tr>
          <tr>
            <td>South Africa</td>
            <td><a href={SOURCES.southAfricanTourism}>South African Tourism</a> says 10–20% is acceptable in restaurants and notes a 10% service charge for tables of more than six guests.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. These are country-specific orientation points, not a universal tipping rule.
    </p>
  </section>

  <section class="section" id="tipping-guide">
    <h2>What percentage should you tip at a restaurant?</h2>
    <div class="guide-grid">
      <div>
        <p class="guide-intro">
          For U.S. sit-down wait service, <strong>Emily Post recommends 15–20% of the pre-tax bill</strong>. That is an
          etiquette recommendation, not a claim that every diner leaves the same amount.
        </p>
        <div class="menu">
          <div class="menu-row">
            <span class="menu-name">Sit-down wait service — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">15–20% pre-tax</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Buffet wait service — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">10% pre-tax</span>
          </div>
          <div class="menu-row">
            <span class="menu-name">Food delivery — etiquette guidance</span><span class="dots" aria-hidden="true"></span><span class="menu-val">10–15%</span>
          </div>
        </div>
        <p class="menu-src">
          Source: <a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a>. For measured restaurant tipping,
          see the <a href="/average-restaurant-tip/">average restaurant tip data page</a>.
        </p>
      </div>
      <div>
        <table class="worked">
          <caption>USD example: a $60 bill at common calculator percentages</caption>
          <thead>
            <tr><th scope="col">Tip</th><th scope="col">Tip amount</th><th scope="col">Bill + tip</th></tr>
          </thead>
          <tbody>
            <tr><td>15%</td><td>$9.00</td><td>$69.00</td></tr>
            <tr><td>18%</td><td>$10.80</td><td>$70.80</td></tr>
            <tr><td>20%</td><td>$12.00</td><td>$72.00</td></tr>
            <tr><td>22%</td><td>$13.20</td><td>$73.20</td></tr>
          </tbody>
        </table>
        <p class="worked-note">
          These are arithmetic examples. Tax and other fees, if entered, are added to the final total separately.
        </p>
      </div>
    </div>
    <p class="menu-src">
      Research last reviewed: {RESEARCH_REVIEW_DATE}. <a href="/methodology/">How we separate data from recommendations.</a>
    </p>
  </section>

  <AdSlot format="leaderboard" position="inline" id="ad-content-1" />

  <section class="section" id="tip-on-tax">
    <h2>Do you tip before tax or after tax?</h2>
    <div class="prose">
      <p>
        Many etiquette guides state percentage recommendations on the <strong>pre-tax subtotal</strong>; Emily Post's
        sit-down guidance is one example. That is a convention, not a law. Some diners prefer to use the final amount
        shown on the check instead.
      </p>
      <p>
        This calculator makes the choice explicit. Enter tax under More options. A percentage tip excludes that entered
        tax by default; switch on <strong>Include tax in percentage tip basis</strong> if you want the percentage
        applied to bill plus tax. Other fees remain outside the percentage tip basis.
      </p>
      <p>
        USD example: on a $60 bill with $4.80 tax, a 20% pre-tax tip is $12.00. If tax is included in the tip basis,
        the same 20% becomes $12.96. The final payable total also includes the $4.80 tax in either case.
      </p>
    </div>
  </section>

  <section class="section" id="service-charges">
    <h2>What if the restaurant bill already has a service charge?</h2>
    <div class="prose">
      <p>
        <strong>Do not decide from the percentage alone.</strong> If the bill clearly identifies an automatic
        gratuity, do not add a second full gratuity automatically. A generic service, hospitality, wellness, or
        administrative fee may work differently. Read the restaurant's disclosure or ask how the charge is treated
        before adding another full tip.
      </p>
      <p>
        See the <a href="/service-charge-on-restaurant-bill/">service-charge guide</a> for the IRS distinction between
        mandatory charges and voluntary tips, plus a practical decision framework.
      </p>
    </div>
  </section>

  <section class="section" id="faq">
    <h2>Restaurant tipping questions, answered</h2>
    <div class="faq">
      <details>
        <summary>How much do you tip on a $50 restaurant bill?</summary>
        <p>
          In this USD example, a 15% tip is $7.50, 18% is $9.00, and 20% is $10.00. Before tax or other fees, those
          produce totals of $57.50, $59.00, and $60.00 respectively.
        </p>
      </details>
      <details>
        <summary>What is the average restaurant tip?</summary>
        <p>
          It depends on what is being measured. Toast's latest published Q1 2026 platform data reports a 19.3%
          full-service average among its applicable card and digital tip transactions; cash is excluded. Pew's 2023
          stated-behavior survey found a different distribution. <a href="/average-restaurant-tip/">See both sources and their limitations.</a>
        </p>
      </details>
      <details>
        <summary>How much should you tip a waiter or waitress?</summary>
        <p>
          Emily Post recommends 15–20% of the pre-tax bill for U.S. sit-down wait service. For service problems,
          exceptional service, or a charge already on the check, see the
          <a href="/how-much-tip-waitress-waiter/">practical server tipping guide</a>.
        </p>
      </details>
      <details>
        <summary>How much should you tip at a buffet?</summary>
        <p>
          Emily Post recommends 10% pre-tax for buffet wait service. Buffet formats vary, so the
          <a href="/buffet-tipping-guide/">buffet guide</a> explains how table service changes the decision without
          pretending there is one measured national buffet average.
        </p>
      </details>
      <details>
        <summary>How much should you tip for food delivery?</summary>
        <p>
          For U.S. delivery, Emily Post recommends 10–15% and gives $2–5 as pizza-delivery guidance depending on order
          size and difficulty. The <a href="/food-delivery-tip-calculator/">delivery calculator</a> accepts any
          percentage or custom tip amount and keeps delivery fees separate from the percentage tip basis.
        </p>
      </details>
      <details>
        <summary>How do you split a restaurant bill when the cents do not divide evenly?</summary>
        <p>
          The calculator reconciles the exact total to the cent. In this USD example, if $10.00 is split three ways,
          one person pays $3.34 and two pay $3.33. The optional round-up mode is different: it raises each share to the
          next whole currency unit and clearly shows the extra money collected.
        </p>
      </details>
    </div>
  </section>

  <section class="section" id="research">
    <h2>Research behind the guidance</h2>
    <ul class="prose">
      <li><a href={SOURCES.emilyPost}>Emily Post — General Tipping Guide</a> for U.S. etiquette recommendations.</li>
      <li>The country comparison above links each international claim directly to the relevant government or official national tourism source.</li>
      <li><a href={SOURCES.toastTipping}>Toast — Restaurant Tipping Trends</a> for Q1 2026 observed U.S. card/digital restaurant tipping data.</li>
      <li><a href={SOURCES.pewTipping}>Pew Research Center — 2023 tipping survey</a> for stated U.S. consumer behavior.</li>
    </ul>
    <p class="menu-src">
      See <a href="/methodology/">Methodology</a> for calculation rules, source hierarchy, research freshness, and
      limitations.
    </p>
  </section>

  <AdSlot format="native" position="inline" id="ad-native" />

  <Related exclude="/" />
</Layout>
