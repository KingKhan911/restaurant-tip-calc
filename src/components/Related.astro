---
interface Card {
  href: string;
  title: string;
  blurb: string;
}

interface Props {
  exclude?: string;
}

const cards: Card[] = [
  {
    href: '/food-delivery-tip-calculator/',
    title: 'Food Delivery Tip Calculator',
    blurb: 'Calculate a percentage or custom-dollar delivery tip and understand fees separately.',
  },
  {
    href: '/average-restaurant-tip/',
    title: 'Average Restaurant Tip',
    blurb: 'Compare observed transaction data, survey responses, and etiquette guidance.',
  },
  {
    href: '/how-much-tip-waitress-waiter/',
    title: 'Waiter & Waitress Tips',
    blurb: 'Practical U.S. table-service guidance, including service problems and added charges.',
  },
  {
    href: '/buffet-tipping-guide/',
    title: 'Buffet Tipping Guide',
    blurb: 'Buffet etiquette by service level, from self-service to server-assisted meals.',
  },
  {
    href: '/service-charge-on-restaurant-bill/',
    title: 'Service Charge Explained',
    blurb: 'Read automatic gratuities, service fees, and unclear charges without guessing by percentage.',
  },
];

const { exclude = '' } = Astro.props;
const shown = cards.filter((c) => c.href !== exclude);
---

<section class="section" id="more-guides" aria-label="More tipping guides">
  <h2>More tipping guides</h2>
  <div class="related">
    {shown.map((c) => (
      <a class="related-card" href={c.href}>
        <span class="related-title">{c.title}</span>
        <span class="related-blurb">{c.blurb}</span>
      </a>
    ))}
  </div>
</section>