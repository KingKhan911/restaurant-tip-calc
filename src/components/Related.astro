---
interface Card {
  href: string;
  title: string;
  blurb: string;
}

interface Props {
  exclude?: string;
}

const cards: Card[] = [
  {
    href: '/food-delivery-tip-calculator/',
    title: 'Food Delivery Tip Calculator',
    blurb: 'Tip your driver right — 15–20% of the subtotal, never the fee.',
  },
  {
    href: '/average-restaurant-tip/',
    title: 'Average Restaurant Tip',
    blurb: 'What most diners actually leave, with data and examples.',
  },
  {
    href: '/how-much-tip-waitress-waiter/',
    title: 'Waiter & Waitress Tips',
    blurb: 'The 15–20% scale, from adequate service to exceptional.',
  },
  {
    href: '/buffet-tipping-guide/',
    title: 'Buffet Tipping Guide',
    blurb: '10% minimum, 15–20% full service, $1–2 at the counter.',
  },
  {
    href: '/service-charge-on-restaurant-bill/',
    title: 'Service Charge Explained',
    blurb: 'Automatic gratuity or restaurant fee — and when to skip the tip.',
  },
];

const { exclude = '' } = Astro.props;
const shown = cards.filter((c) => c.href !== exclude);
---

<section class="section" id="more-guides" aria-label="More tipping guides">
  <h2>More tipping guides</h2>
  <div class="related">
    {shown.map((c) => (
      <a class="related-card" href={c.href}>
        <span class="related-title">{c.title}</span>
        <span class="related-blurb">{c.blurb}</span>
      </a>
    ))}
  </div>
</section>