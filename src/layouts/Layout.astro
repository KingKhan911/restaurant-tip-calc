---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import {
  ADS_ENABLED,
  DEFAULT_SOCIAL_IMAGE_PATH,
  SITE_NAME,
  SITE_ORIGIN,
} from '../lib/site.js';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: string;
  nav?: NavLink[];
  noindex?: boolean;
  ads?: boolean;
}

const pillarNav: NavLink[] = [
  { href: '#calculator', label: 'Calculator' },
  { href: '#tipping-guide', label: 'Guide' },
  { href: '#faq', label: 'FAQ' },
];

const footerGroups: { label: string; links: NavLink[] }[] = [
  {
    label: 'Tools',
    links: [
      { href: '/', label: 'Tip Calculator' },
      { href: '/food-delivery-tip-calculator/', label: 'Delivery Calculator' },
    ],
  },
  {
    label: 'Guides',
    links: [
      { href: '/average-restaurant-tip/', label: 'Average Restaurant Tip' },
      { href: '/how-much-tip-waitress-waiter/', label: 'Waiter & Waitress Tips' },
      { href: '/buffet-tipping-guide/', label: 'Buffet Tipping' },
      { href: '/service-charge-on-restaurant-bill/', label: 'Service Charge' },
    ],
  },
  {
    label: 'Site',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/methodology/', label: 'Methodology' },
      { href: '/privacy/', label: 'Privacy' },
    ],
  },
];

const {
  title,
  description,
  path,
  jsonLd,
  nav = pillarNav,
  noindex = false,
  ads = true,
} = Astro.props;

const canonical = new URL(path, SITE_ORIGIN).href;
const socialImage = new URL(DEFAULT_SOCIAL_IMAGE_PATH, SITE_ORIGIN).href;
const adsEnabled = ADS_ENABLED && ads;
const currentYear = new Date().getFullYear();
const footerCurrencyNote =
  path === '/'
    ? 'Supports user-selected display currencies; no exchange-rate conversion.'
    : 'Amounts in US dollars.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F6F1E7" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Restaurant Tip Calculator receipt card showing tip, total, and an exact bill split." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Restaurant Tip Calculator receipt card showing tip, total, and an exact bill split." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Spline+Sans+Mono:wght@400;600;700&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body id="top" class:list={{ 'ads-enabled': adsEnabled }}>
    <a class="skip" href="#main-content">Skip to content</a>

    <div class="shell">
      <div class="wrap">
        <header class="site-head">
          <a class="brand" href="/" aria-label="Restaurant Tip Calculator — home">
            <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
              <ellipse cx="13" cy="13" rx="10.5" ry="6.8" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="13" cy="3.4" r="1.9" fill="#B5432A" />
              <circle cx="4.4" cy="18.6" r="1.9" fill="currentColor" />
              <circle cx="21.6" cy="18.6" r="1.9" fill="currentColor" />
            </svg>
            {SITE_NAME}
          </a>
          <nav class="site-nav" aria-label="Site">
            {nav.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </header>

        <main id="main-content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-foot">
          <div class="foot-inner">
            <div>
              <span class="foot-brand">
                <svg width="20" height="20" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
                  <ellipse cx="13" cy="13" rx="10.5" ry="6.8" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="13" cy="3.4" r="1.9" fill="#B5432A" />
                  <circle cx="21.6" cy="18.6" r="1.9" fill="currentColor" />
                  <circle cx="4.4" cy="18.6" r="1.9" fill="currentColor" />
                </svg>
                {SITE_NAME}
              </span>
              <p class="foot-note">
                A fast tip calculator. Calculator values stay in your browser and are not sent to a custom server.
              </p>
            </div>
            <nav class="foot-nav" aria-label="Footer">
              {footerGroups.map((group) => (
                <div class="foot-column">
                  <span class="foot-group">{group.label}</span>
                  {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
                </div>
              ))}
            </nav>
            <p class="foot-copy">© {currentYear} {SITE_NAME}. {footerCurrencyNote}</p>
          </div>
        </footer>
      </div>

      <AdSlot format="rail" enabled={adsEnabled} />
    </div>

    <AdSlot format="anchor" enabled={adsEnabled} />

    <div class="sr-only" role="status" aria-live="polite" id="announce"></div>
  </body>
</html>
